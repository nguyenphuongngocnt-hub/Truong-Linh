<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Luyện Thi Toán ASMO Lớp 6 - Tương Tác Trực Tuyến</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- React & ReactDOM CDN -->
    <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <!-- Babel Standalone CDN -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Lexend', sans-serif; background-color: #f8fafc; }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState } = React;

        // DỮ LIỆU ĐỀ BÀI + ĐÁP ÁN + LỜI GIẢI CHI TIẾT + KIẾN THỨC TRỌNG TÂM (ASMO GRADE 6)
        const QUESTIONS_DATA = [
            {
                id: 1,
                questionEn: "In the following multiplication, the same digit is used in each square: [ ] [ ] x [ ] = 176. Which digit must be used so that the statement is correct?",
                questionVi: "Trong phép nhân sau, mỗi ô vuông đều sử dụng cùng một chữ số: [ ] [ ] x [ ] = 176. Phải sử dụng chữ số nào để phép tính đúng?",
                answer: "4",
                explanation: "Đáp án chuẩn: 4 (vì 44 x 4 = 176).",
                solution: "1. Gọi chữ số cần tìm trong ô vuông là x (với x từ 1 đến 9).\n2. Ta có phép nhân: (10x + x) * x = 176 => 11 * x * x = 176.\n3. Suy ra: x * x = 176 / 11 = 16.\n4. Do 4 * 4 = 16 nên chữ số x cần tìm là 4.",
                keyConcept: "📌 Phương pháp thế chữ số & Cấu tạo số: Phân tích số có 2 chữ số giống nhau thành (11 x x) và giải phương trình tìm chữ số thích hợp."
            },
            {
                id: 2,
                questionEn: "Kathy draws a square with side length 10 cm. Then she joins the midpoints of each side to form a smaller square. What is the area of the smaller square?",
                questionVi: "Kathy vẽ một hình vuông có cạnh dài 10 cm. Sau đó, cô ấy nối các điểm giữa của mỗi cạnh để tạo thành một hình vuông nhỏ hơn. Diện tích của hình vuông nhỏ hơn là bao nhiêu?",
                answer: "50",
                explanation: "Đáp án chuẩn: 50 cm².",
                solution: "1. Diện tích hình vuông lớn ban đầu là: 10 x 10 = 100 (cm²).\n2. Nối các trung điểm của 4 cạnh hình vuông lớn tạo thành 4 tam giác vuông bằng nhau ở 4 góc và 1 hình vuông nhỏ ở giữa.\n3. Tổng diện tích 4 tam giác vuông góc bằng một nửa diện tích hình vuông lớn.\n4. Diện tích hình vuông nhỏ ở giữa bằng đúng một nửa diện tích hình vuông lớn: 100 / 2 = 50 (cm²).",
                keyConcept: "📌 Bất biến hình học: Hình vuông tạo bởi các trung điểm của hình vuông ban đầu luôn có diện tích bằng 1/2 diện tích hình vuông lớn."
            },
            {
                id: 3,
                questionEn: "The pages of a book are numbered consecutively, beginning with 1. The digit 7 is printed 25 times in numbering the pages. What is the largest number of pages the book can have?",
                questionVi: "Các trang của một cuốn sách được đánh số liên tiếp, bắt đầu từ 1. Chữ số 7 được in 25 lần để đánh số trang. Số trang lớn nhất mà cuốn sách có thể có là bao nhiêu?",
                answer: "156",
                explanation: "Đáp án chuẩn: 156 trang.",
                solution: "1. Đếm số lần chữ số 7 xuất hiện từ trang 1 đến 99: Có 20 chữ số 7 (7, 17, 27, 37, 47, 57, 67, 70..79, 87, 97).\n2. Từ trang 100 đến 149: Thêm 5 chữ số 7 nữa (107, 117, 127, 137, 147) -> Đã dùng đủ 20 + 5 = 25 chữ số 7 tại trang 147.\n3. Để số trang là LỚN NHẤT, cuốn sách có thể kéo dài tối đa đến ngay trước trang tiếp theo có chứa chữ số 7 (là trang 157).\n4. Vậy số trang lớn nhất cuốn sách có thể có là 156 trang.",
                keyConcept: "📌 Bài toán đếm chữ số & Giá trị lớn nhất: Xác định ngưỡng xuất hiện đủ số lần yêu cầu, sau đó mở rộng tối đa đến trước vị trí xuất hiện chữ số đó lần tiếp theo."
            },
            {
                id: 4,
                questionEn: "Each figure below is formed by these black tiles with white tiles. How many white tiles will be in the figure formed by 54 black tiles?",
                questionVi: "Mỗi hình được tạo bởi các viên gạch đen và gạch trắng. Sẽ có bao nhiêu viên gạch trắng trong hình được tạo thành bởi 54 viên gạch đen?",
                answer: "73",
                explanation: "Đáp án chuẩn: 73 viên gạch trắng.",
                solution: "1. Phân tích quy luật liên hệ giữa số gạch đen và gạch trắng từ hình vẽ.\n2. Lập công thức tổng quát giữa số gạch đen (B) và số gạch trắng (W).\n3. Thay B = 54 vào quy luật để tính ra kết quả W = 73.",
                keyConcept: "📌 Dãy số quy luật hình học: Tìm công thức liên hệ tuyến tính W = a*B + b từ các hình mẫu ban đầu."
            },
            {
                id: 5,
                questionEn: "Isabella has 30 coins, consisting of quarters (25 cents) and dimes (10 cents), which total $5.70. How many quarters does she have?",
                questionVi: "Isabella có 30 đồng xu gồm đồng 25 cent và đồng 10 cent, tổng cộng là $5.70. Cô ấy có bao nhiêu đồng 25 cent?",
                answer: "18",
                explanation: "Đáp án chuẩn: 18 đồng 25 cent.",
                solution: "1. Đổi $5.70 = 570 cent.\n2. Giả sử cả 30 đồng xu đều là đồng 10 cent, tổng giá trị là: 30 x 10 = 300 cent.\n3. Số cent bị hụt so với thực tế: 570 - 300 = 270 cent.\n4. Thay một đồng 10 cent bằng một đồng 25 cent thì tổng giá trị tăng thêm: 25 - 10 = 15 cent.\n5. Số đồng 25 cent là: 270 / 15 = 18 (đồng).",
                keyConcept: "📌 Phương pháp Giả thiết tạm: Giả định tất cả thuộc về một loại, tính lượng chênh lệch rồi chia cho khoảng chênh lệch giữa 2 loại."
            }
        ];

        function App() {
            const [userAnswers, setUserAnswers] = useState({});
            const [showFeedback, setShowFeedback] = useState({});
            const [score, setScore] = useState(null);

            const handleInputChange = (id, val) => {
                setUserAnswers({ ...userAnswers, [id]: val });
            };

            const checkSingleAnswer = (id) => {
                setShowFeedback({ ...showFeedback, [id]: true });
            };

            const cleanStr = (str) => str ? str.toString().trim().toLowerCase().replace(/\s+/g, '') : '';

            const handleCheckAll = () => {
                let correctCount = 0;
                const newFeedback = {};
                QUESTIONS_DATA.forEach(q => {
                    newFeedback[q.id] = true;
                    if (cleanStr(userAnswers[q.id]) === cleanStr(q.answer)) {
                        correctCount++;
                    }
                });
                setShowFeedback(newFeedback);
                setScore(correctCount);
            };

            const handleReset = () => {
                setUserAnswers({});
                setShowFeedback({});
                setScore(null);
            };

            return (
                <div className="min-h-screen pb-12">
                    {/* Header */}
                    <header className="bg-indigo-600 text-white py-6 px-4 shadow-md mb-8">
                        <div className="max-w-4xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4">
                            <div>
                                <h1 className="text-2xl font-bold tracking-tight">🧮 Luyện Thi Toán ASMO Lớp 6</h1>
                                <p className="text-indigo-100 text-sm mt-1">Hệ thống bài tập tương tác - Lời giải chi tiết & Trọng tâm kiến thức</p>
                            </div>
                            <div className="flex gap-2">
                                <button onClick={handleCheckAll} className="bg-emerald-500 hover:bg-emerald-600 text-white font-medium px-4 py-2 rounded-lg transition shadow">
                                    Nộp Bài & Chấm Điểm
                                </button>
                                <button onClick={handleReset} className="bg-indigo-700 hover:bg-indigo-800 text-white font-medium px-3 py-2 rounded-lg transition">
                                    Làm Lại
                                </button>
                            </div>
                        </div>
                    </header>

                    {/* Main Content */}
                    <main className="max-w-4xl mx-auto px-4">
                        {/* Score Banner */}
                        {score !== null && (
                            <div className="bg-white border-2 border-indigo-500 rounded-xl p-6 mb-8 text-center shadow-lg animate-bounce">
                                <h2 className="text-xl font-bold text-gray-800">Kết Quả Bài Làm</h2>
                                <p className="text-3xl font-extrabold text-indigo-600 my-2">{score} / {QUESTIONS_DATA.length} Câu Đúng</p>
                                <p className="text-gray-600 text-sm">
                                    {score === QUESTIONS_DATA.length ? "🎉 Xuất sắc! Bạn đã nắm vững toàn bộ kiến thức!" : "💪 Hãy xem lại các lời giải chi tiết bên dưới để hoàn thiện nhé!"}
                                </p>
                            </div>
                        )}

                        {/* Question List */}
                        <div className="space-y-6">
                            {QUESTIONS_DATA.map((q, index) => {
                                const isSubmitted = showFeedback[q.id];
                                const isCorrect = cleanStr(userAnswers[q.id]) === cleanStr(q.answer);

                                return (
                                    <div key={q.id} className="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                                        {/* Card Header */}
                                        <div className="bg-slate-50 px-6 py-3 border-b border-slate-200 flex justify-between items-center">
                                            <span className="font-bold text-indigo-600">Câu {index + 1}</span>
                                            <span className="text-xs bg-slate-200 text-slate-700 px-2 py-1 rounded">ASMO Grade 6</span>
                                        </div>

                                        {/* Question Content */}
                                        <div className="p-6">
                                            <p className="text-slate-800 font-medium mb-2">{q.questionVi}</p>
                                            <p className="text-slate-500 text-sm italic mb-4">{q.questionEn}</p>

                                            {/* Input Area */}
                                            <div className="flex flex-wrap gap-3 items-center mb-4">
                                                <input 
                                                    type="text" 
                                                    value={userAnswers[q.id] || ''} 
                                                    onChange={(e) => handleInputChange(q.id, e.target.value)}
                                                    placeholder="Nhập đáp án..." 
                                                    className={`border rounded-lg px-4 py-2 w-64 focus:outline-none focus:ring-2 ${
                                                        isSubmitted 
                                                            ? (isCorrect ? 'border-emerald-500 bg-emerald-50 text-emerald-800 font-bold' : 'border-rose-500 bg-rose-50 text-rose-800') 
                                                            : 'border-slate-300 focus:ring-indigo-400'
                                                    }`}
                                                />
                                                <button 
                                                    onClick={() => checkSingleAnswer(q.id)}
                                                    className="bg-slate-800 hover:bg-slate-900 text-white px-4 py-2 rounded-lg text-sm transition"
                                                >
                                                    Kiểm Tra
                                                </button>
                                            </div>

                                            {/* FEEDBACK & SOLUTION BOX */}
                                            {isSubmitted && (
                                                <div className={`mt-4 rounded-lg p-5 border ${isCorrect ? 'bg-emerald-50 border-emerald-200' : 'bg-rose-50 border-rose-200'}`}>
                                                    <div className="flex items-center gap-2 mb-3">
                                                        <span className={`text-lg font-bold ${isCorrect ? 'text-emerald-700' : 'text-rose-700'}`}>
                                                            {isCorrect ? "✅ Tốt lắm! Đáp án chính xác." : "❌ Chưa chính xác!"}
                                                        </span>
                                                    </div>

                                                    {/* Đáp án, Lời giải & Trọng tâm kiến thức */}
                                                    <div className="space-y-3 text-sm text-slate-700">
                                                        <div className="font-semibold text-slate-900">
                                                            🔑 {q.explanation}
                                                        </div>
                                                        <div className="bg-white/80 p-3 rounded border border-slate-200 whitespace-pre-line">
                                                            <strong className="text-indigo-600 block mb-1">📝 Lời giải chi tiết:</strong>
                                                            {q.solution}
                                                        </div>
                                                        <div className="bg-indigo-50/80 p-3 rounded border border-indigo-100 text-indigo-900">
                                                            {q.keyConcept}
                                                        </div>
                                                    </div>
                                                </div>
                                            )}
                                        </div>
                                    </div>
                                );
                            })}
                        </div>
                    </main>

                    {/* Footer */}
                    <footer className="text-center text-slate-400 text-xs py-8">
                        © 2026 Interactive Math Learning App. Powered by React & GitHub Pages.
                    </footer>
                </div>
            );
        }

        ReactDOM.createRoot(document.getElementById('root')).render(<App />);
    </script>
</body>
</html>
